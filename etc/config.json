[
    {
      "name": "webots",
      "directory": ".",
      "command": "webots"
    },
    {
      "name": "rcnode",
      "directory": ".",
      "command": "bash $ROBOCOMP/tools/rcnode/rcnode.sh"
    },
    {
      "name": "bridge",
