    },
    {
      "name": "bpearl",
      "directory": "$ROBOCOMP/components/robocomp-robolab/components/hardware/laser/lidar3D",
      "command": "bin/Lidar3D etc/config_pearl_webots"
    },
    {
      "name": "viewer_helios",
      "directory": "$ROBOCOMP/components/robocomp-robolab/components/viewers/lidar3d_viewer",
      "command": "bin/lidar3dviewer etc/config_helios"
    },
    {
      "name": "viewer_bpearl",
      "directory": "$ROBOCOMP/components/robocomp-robolab/components/viewers/lidar3d_viewer",
      "command": "bin/lidar3dviewer etc/config_pearl"
    }
  ]